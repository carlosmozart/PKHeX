<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="Margin" Value="0,12,0,6" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>

  <!-- Botoes -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,7" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <!-- Slot de caixa (cartao responsivo) -->
  <Style Selector="Button.slot">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="150" />
    <Setter Property="Margin" Value="5" />
    <Setter Property="Padding" Value="8,6,8,8" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
    <Setter Property="Background" Value="{DynamicResource SlotBackground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.slot:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.04)" />
  </Style>
  <Style Selector="Button.slot:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SlotHover}" />
  </Style>
  <Style Selector="Button.slot.empty">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.slot.selected /template/ ContentPresenter, Button.slot.selected:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <Style Selector="Button.slot.mini">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="56" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="Padding" Value="6,4" />
  </Style>
  <Style Selector="Button.slot.dropTarget /template/ ContentPresenter, Button.partyCard.dropTarget /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource SlotHover}" />
  </Style>
  <Style Selector="Button.slot.dropTarget, Button.partyCard.dropTarget">
    <Setter Property="RenderTransform" Value="scale(1.06)" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="TextBlock.slotPos">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="TextBlock.slotName">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.slotLevel">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="TextBlock.shiny">
    <Setter Property="Foreground" Value="#F5B83D" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Border.spriteWell">
    <Setter Property="Background" Value="{DynamicResource SlotBackground}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style Selector="TextBox, ComboBox, NumericUpDown">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Listas compactas (mochila) -->
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="6,3" />
  </Style>

  <!-- Navegacao lateral -->
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Abas em pilula (bolsos da mochila) -->
  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Background" Value="{DynamicResource SlotBackground}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Cartao da equipe -->
  <Style Selector="Button.partyCard">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,0,12,12" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.partyCard.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Chips (tipo, legalidade) -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="9,2" />
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Editor -->
  <Style Selector="Border.hero">
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="TextBlock.up">
    <Setter Property="Foreground" Value="#F0616D" />
  </Style>
  <Style Selector="TextBlock.down">
    <Setter Property="Foreground" Value="#5B9DF5" />
  </Style>
  <Style Selector="ProgressBar.base">
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource SlotBackground}" />
  </Style>
  <Style Selector="Slider.stat">
    <Setter Property="Margin" Value="0,-10" />
  </Style>
  <Style Selector="Slider.stat /template/ Thumb">
    <Setter Property="Background" Value="{Binding $parent[Slider].Foreground}" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <Style Selector="Slider.stat /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{Binding $parent[Slider].Foreground}" />
  </Style>
  <Style Selector="Slider.stat:pointerover /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{Binding $parent[Slider].Foreground}" />
  </Style>
</Styles>
