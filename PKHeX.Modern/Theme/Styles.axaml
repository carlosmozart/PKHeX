<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="Margin" Value="0,12,0,6" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>

  <!-- Botoes -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,7" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <!-- Botoes coloridos por funcao (barra inferior): good = verde, info = azul, danger = vermelho, soft = destaque suave -->
  <Style Selector="Button.good, Button.info, Button.danger, Button.soft">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.good /template/ ContentPresenter, Button.good:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TintGoodBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource TintGoodForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TintGoodBackground}" />
  </Style>
  <Style Selector="Button.info /template/ ContentPresenter, Button.info:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TintInfoBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource TintInfoForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TintInfoBackground}" />
  </Style>
  <Style Selector="Button.danger /template/ ContentPresenter, Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TintDangerBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource TintDangerForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TintDangerBackground}" />
  </Style>
  <Style Selector="Button.soft /template/ ContentPresenter, Button.soft:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.good:pointerover /template/ ContentPresenter, Button.info:pointerover /template/ ContentPresenter, Button.danger:pointerover /template/ ContentPresenter, Button.soft:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="Button.good:disabled, Button.info:disabled, Button.danger:disabled, Button.soft:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <!-- Salvar: o botao mais importante da barra -->
  <Style Selector="Button.primary">
    <Setter Property="Padding" Value="16,5" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <!-- Slot de caixa (cartao responsivo) -->
  <Style Selector="Button.slot">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="150" />
    <Setter Property="Margin" Value="5" />
    <Setter Property="Padding" Value="8,6,8,8" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
    <Setter Property="Background" Value="{DynamicResource SlotBackground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.slot:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.04)" />
  </Style>
  <Style Selector="Button.slot:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SlotHover}" />
  </Style>
  <Style Selector="Button.slot.empty">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.slot.selected /template/ ContentPresenter, Button.slot.selected:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <!-- Pokedex -->
  <Style Selector="Button.dexCard">
    <Setter Property="Width" Value="104" />
    <Setter Property="Height" Value="104" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.dexCard.owned /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource TintGoodForeground}" />
  </Style>
  <Style Selector="Button.dexCard.missing">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Button.dexCard.selected /template/ ContentPresenter, Button.dexCard.selected:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <Style Selector="TextBlock.alpha">
    <Setter Property="Foreground" Value="#E5484D" />
  </Style>
  <Style Selector="TextBlock.dexOwned">
    <Setter Property="Foreground" Value="{DynamicResource TintGoodForeground}" />
  </Style>
  <Style Selector="Border.dexStats">
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <!-- Selecao multipla -->
  <Style Selector="Button.slot.marked /template/ ContentPresenter, Button.slot.marked:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <Style Selector="TextBlock.markCheck">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="5,1" />
  </Style>
  <Style Selector="Border.selectionBar">
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Margin" Value="0,0,0,-12" />
    <Setter Property="BoxShadow" Value="0 6 24 0 #50000000" />
  </Style>
  <Style Selector="Button.slot.mini">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="56" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="Padding" Value="6,4" />
  </Style>
  <Style Selector="Button.slot.dropTarget /template/ ContentPresenter, Button.partyCard.dropTarget /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource SlotHover}" />
  </Style>
  <Style Selector="Button.slot.dropTarget, Button.partyCard.dropTarget">
    <Setter Property="RenderTransform" Value="scale(1.06)" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Busca global -->
  <Style Selector="Button.slot.match /template/ ContentPresenter, Button.partyCard.match /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="#F5B83D" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.slot.dimmed, Button.partyCard.dimmed">
    <Setter Property="Opacity" Value="0.3" />
  </Style>
  <Style Selector="Button.searchHit">
    <Setter Property="Padding" Value="6,3" />
  </Style>

  <Style Selector="TextBlock.slotPos">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="TextBlock.slotName">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.slotLevel">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="TextBlock.shiny">
    <Setter Property="Foreground" Value="#F5B83D" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.male">
    <Setter Property="Foreground" Value="#4A90E2" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.female">
    <Setter Property="Foreground" Value="#E85D9A" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.legalOk">
    <Setter Property="Foreground" Value="{DynamicResource Good}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="TextBlock.legalBad">
    <Setter Property="Foreground" Value="#F5A524" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Border.actionBar">
    <Setter Property="Background" Value="{DynamicResource SidebarBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="16,8" />
  </Style>
  <Style Selector="TabControl.editorTabs">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TabControl.editorTabs TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="TabControl.editorTabs TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Border.saveCard">
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.saveCard:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="Border.saveCard.current">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Border.dialogBackdrop">
    <Setter Property="Background" Value="#99000000" />
  </Style>
  <Style Selector="Border.dialog">
    <Setter Property="Padding" Value="22" />
    <Setter Property="BoxShadow" Value="0 12 40 0 #66000000" />
  </Style>
  <Style Selector="Border.dialogDetails">
    <Setter Property="Background" Value="{DynamicResource SlotBackground}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="TextBlock.good">
    <Setter Property="Foreground" Value="{DynamicResource Good}" />
  </Style>
  <Style Selector="TextBlock.bad">
    <Setter Property="Foreground" Value="#F5A524" />
  </Style>
  <Style Selector="Button.unsavedLink">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="TextBlock.unsaved">
    <Setter Property="Foreground" Value="#F5A524" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.encCard">
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.moveRow">
    <Setter Property="Padding" Value="0,4,0,8" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="ProgressBar.pp">
    <Setter Property="Height" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Foreground" Value="#4FA3F7" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <!-- Resumo do hover nos slots (como no PKHeX): largo o bastante para as linhas do set e do encontro -->
  <Style Selector="Button.slot, Button.partyCard">
    <Setter Property="ToolTip.ShowDelay" Value="250" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="MaxWidth" Value="520" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <!-- Seletor de cor de destaque -->
  <Style Selector="Button.accentDot">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.accentDot /template/ ContentPresenter">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.accentDot.selected /template/ ContentPresenter, Button.accentDot:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource TextMuted}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.accentDot.selected /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>
  <Style Selector="Button.accentDot.selected">
    <Setter Property="RenderTransform" Value="scale(1.2)" />
  </Style>
  <!-- Lista de golpes: os que o Pokemon aprende ficam no topo com fundo verde -->
  <Style Selector="Border.moveOption">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="-8,-4" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Border.moveOption.learnable">
    <Setter Property="Background" Value="#2E46A758" />
  </Style>
  <Style Selector="Border.moveOption.learnable TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Good}" />
  </Style>
  <!-- Bank: cartoes compactos para caber duas telas lado a lado -->
  <Style Selector="Border.bankPane">
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Button.slot.compact">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="104" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="Padding" Value="5,4" />
  </Style>
  <Style Selector="Button.slot.compact:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.03)" />
  </Style>
  <!-- Abas de caixa -->
  <Style Selector="Button.boxTab">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="Button.boxTab.current /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.boxTab.current">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.spriteWell">
    <Setter Property="Background" Value="{DynamicResource SlotBackground}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style Selector="TextBox, ComboBox, NumericUpDown">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Listas compactas (mochila) -->
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="6,3" />
  </Style>

  <!-- Navegacao lateral -->
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Abas em pilula (bolsos da mochila) -->
  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Background" Value="{DynamicResource SlotBackground}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Cartao da equipe -->
  <Style Selector="Button.partyCard">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,0,12,12" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.partyCard.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Chips (tipo, legalidade) -->
  <!-- Ajuda › Sobre: cartao do AllGenWiki com borda de destaque -->
  <Style Selector="Border.wikiCard">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Selo do jogo: Pokemon da capa sobre o degrade da versao -->
  <Style Selector="Border.gameBadge">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="BoxShadow" Value="0 2 6 0 #40000000" />
  </Style>
  <Style Selector="Border.gameBadge > Image">
    <Setter Property="Stretch" Value="Uniform" />
  </Style>
  <!-- Cartao de encontro clicavel (abre o painel de detalhes) -->
  <Style Selector="Button.encCardButton">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.encCardButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.encCardButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.encCardButton:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Border.encCard.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Marcacoes do editor (●▲■♥★◆): apagada, azul (ligada) ou rosa -->
  <Style Selector="Button.marking">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="Button.marking.on">
    <Setter Property="Foreground" Value="#4FA3F7" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.marking.pink">
    <Setter Property="Foreground" Value="#F06292" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Modo legal: aviso acima do Aplicar quando o Pokemon esta ilegal -->
  <Style Selector="Border.legalBlock">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Bad}" />
    <Setter Property="Background" Value="#22E5484D" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="9,2" />
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Editor -->
  <Style Selector="Border.hero">
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="TextBlock.up">
    <Setter Property="Foreground" Value="#F0616D" />
  </Style>
  <Style Selector="TextBlock.down">
    <Setter Property="Foreground" Value="#5B9DF5" />
  </Style>
  <Style Selector="ProgressBar.base">
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource SlotBackground}" />
  </Style>
  <Style Selector="Slider.stat">
    <Setter Property="Margin" Value="0,-10" />
  </Style>
  <Style Selector="Slider.stat /template/ Thumb">
    <Setter Property="Background" Value="{Binding $parent[Slider].Foreground}" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <Style Selector="Slider.stat /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{Binding $parent[Slider].Foreground}" />
  </Style>
  <Style Selector="Slider.stat:pointerover /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{Binding $parent[Slider].Foreground}" />
  </Style>

  <!-- Cartao do modo legal (barra lateral) -->
  <Style Selector="ToggleButton.legalCard">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ToggleButton.legalCard /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TintWarnBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TintWarnForeground}" />
  </Style>
  <Style Selector="ToggleButton.legalCard:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TintGoodBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TintGoodForeground}" />
  </Style>
  <Style Selector="ToggleButton.legalCard:pointerover /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="ToggleButton.legalCard Path.legalShield">
    <Setter Property="Fill" Value="{DynamicResource TintWarnForeground}" />
  </Style>
  <Style Selector="ToggleButton.legalCard:checked Path.legalShield">
    <Setter Property="Fill" Value="{DynamicResource TintGoodForeground}" />
  </Style>
  <Style Selector="ToggleButton.legalCard Path.legalMark">
    <Setter Property="Stroke" Value="{DynamicResource SidebarBackground}" />
  </Style>
  <Style Selector="ToggleButton.legalCard TextBlock.legalTitle">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TintWarnForeground}" />
  </Style>
  <Style Selector="ToggleButton.legalCard:checked TextBlock.legalTitle">
    <Setter Property="Foreground" Value="{DynamicResource TintGoodForeground}" />
  </Style>
  <Style Selector="ToggleButton.legalCard TextBlock.legalState">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>

  <!-- Variantes do bank -->
  <Style Selector="Border.variantsPanel">
    <Setter Property="Margin" Value="0,10,0,0" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource TintInfoBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TintInfoForeground}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.variantRow">
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
  </Style>
  <Style Selector="Border.formatChip">
    <Setter Property="Background" Value="{DynamicResource TintInfoForeground}" />
  </Style>


  <!-- Abas dos saves abertos -->
  <Style Selector="Border.saveTabsBar">
    <Setter Property="Margin" Value="0,-12,0,14" />
    <Setter Property="Padding" Value="0,0,0,8" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Button.saveTab">
    <Setter Property="Padding" Value="8,5,4,5" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="Button.saveTab:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.saveTab.active">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.saveTab.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="TextBlock.tabDirty">
    <Setter Property="Foreground" Value="{DynamicResource TintWarnForeground}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.tabClose">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="5,2" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="Button.tabClose:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TintDangerBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource TintDangerForeground}" />
  </Style>
  <Style Selector="Button.tabNew">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
</Styles>
