<!-- Toda a identidade visual fica aqui: troque as cores sem tocar nas telas. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppBackground" Color="#14161B" />
      <SolidColorBrush x:Key="SidebarBackground" Color="#1B1E25" />
      <SolidColorBrush x:Key="CardBackground" Color="#20242C" />
      <SolidColorBrush x:Key="SlotBackground" Color="#2A2F39" />
      <SolidColorBrush x:Key="SlotHover" Color="#353B48" />
      <SolidColorBrush x:Key="CardBorder" Color="#2E333D" />
      <SolidColorBrush x:Key="TextMuted" Color="#8C93A3" />
      <SolidColorBrush x:Key="Accent" Color="#E5484D" />
      <Color x:Key="SystemAccentColor">#E5484D</Color>
      <Color x:Key="SystemAccentColorDark1">#D13C41</Color>
      <Color x:Key="SystemAccentColorLight1">#F06A6E</Color>
      <Color x:Key="SystemAccentColorLight2">#F48A8D</Color>
      <SolidColorBrush x:Key="AccentSoft" Color="#3A1F24" />
      <SolidColorBrush x:Key="Good" Color="#46A758" />
      <SolidColorBrush x:Key="Bad" Color="#E5484D" />
      <!-- Botoes da barra inferior: texto e fundo translucido por funcao -->
      <SolidColorBrush x:Key="TintGoodForeground" Color="#5FD068" />
      <SolidColorBrush x:Key="TintGoodBackground" Color="#2446A758" />
      <SolidColorBrush x:Key="TintInfoForeground" Color="#7FB2FF" />
      <SolidColorBrush x:Key="TintInfoBackground" Color="#244C8DF6" />
      <SolidColorBrush x:Key="TintDangerForeground" Color="#FF7A80" />
      <SolidColorBrush x:Key="TintDangerBackground" Color="#24E5484D" />
      <SolidColorBrush x:Key="TintWarnForeground" Color="#F5B83D" />
      <SolidColorBrush x:Key="TintWarnBackground" Color="#24F5B83D" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AppBackground" Color="#F4F5F8" />
      <SolidColorBrush x:Key="SidebarBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SlotBackground" Color="#EEF0F4" />
      <SolidColorBrush x:Key="SlotHover" Color="#E1E4EB" />
      <SolidColorBrush x:Key="CardBorder" Color="#E2E5EB" />
      <SolidColorBrush x:Key="TextMuted" Color="#6B7280" />
      <SolidColorBrush x:Key="Accent" Color="#D93D42" />
      <Color x:Key="SystemAccentColor">#D93D42</Color>
      <Color x:Key="SystemAccentColorDark1">#C23136</Color>
      <Color x:Key="SystemAccentColorDark2">#A8282D</Color>
      <Color x:Key="SystemAccentColorLight1">#E5484D</Color>
      <SolidColorBrush x:Key="AccentSoft" Color="#FCE8E9" />
      <SolidColorBrush x:Key="Good" Color="#2F8A42" />
      <SolidColorBrush x:Key="Bad" Color="#D93D42" />
      <SolidColorBrush x:Key="TintGoodForeground" Color="#237A35" />
      <SolidColorBrush x:Key="TintGoodBackground" Color="#1F2F8A42" />
      <SolidColorBrush x:Key="TintInfoForeground" Color="#1D4ED8" />
      <SolidColorBrush x:Key="TintInfoBackground" Color="#1F2563EB" />
      <SolidColorBrush x:Key="TintDangerForeground" Color="#B42328" />
      <SolidColorBrush x:Key="TintDangerBackground" Color="#1FD93D42" />
      <SolidColorBrush x:Key="TintWarnForeground" Color="#A15C00" />
      <SolidColorBrush x:Key="TintWarnBackground" Color="#24E89B0C" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <CornerRadius x:Key="CardRadius">12</CornerRadius>
  <CornerRadius x:Key="SlotRadius">8</CornerRadius>
</ResourceDictionary>
