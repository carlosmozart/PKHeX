<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PKHeX.Modern.ViewModels"
             xmlns:v="using:PKHeX.Modern.Views"
             x:Class="PKHeX.Modern.App"
             RequestedThemeVariant="Dark">
  <!-- Cada ViewModel novo ganha sua View aqui (uma linha por tela/feature). -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:PokemonEditorViewModel">
      <v:PokemonEditorView />
    </DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://PKHeX.Modern/Theme/Styles.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PKHeX.Modern/Theme/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
