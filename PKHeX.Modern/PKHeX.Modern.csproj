<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../PKHeX.Modern.Version.props" />

  <!--
    PKHeX.Modern: interface alternativa (Avalonia) para o PKHeX.
    Regra de ouro: este projeto apenas CONSOME o PKHeX.Core (e os PNGs/codigo de sprites do upstream, via PKHeX.Modern.Sprites).
    Nada aqui deve exigir alteracoes nos projetos do upstream, para que
    "git merge upstream/master" continue sem conflitos.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- net10.0 (sem -windows): roda no Windows, Linux e macOS; os sprites vem do PKHeX.Modern.Sprites (sem System.Drawing). -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PKHeX.Modern</RootNamespace>
    <AssemblyName>PKHeX.Modern</AssemblyName>
    <ApplicationIcon>..\PKHeX.WinForms\Resources\icon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AssemblyName>PKHeX.Modern.UI</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="11.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PKHeX.Core\PKHeX.Core.csproj" />
    <!-- Sprites sem System.Drawing (mesmos PNGs e mesma montagem do PKHeX; ver PKHeX.Modern.Sprites) -->
    <ProjectReference Include="..\PKHeX.Modern.Sprites\PKHeX.Modern.Sprites.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Changelog mostrado em Ajuda › Novidades -->
    <EmbeddedResource Include="CHANGELOG.md" LogicalName="CHANGELOG.md" />
    <!-- Descricoes e locais dos itens, do AllGenWiki (gerado por Tools/build_item_info.py) -->
    <EmbeddedResource Include="Assets\item-info.json" LogicalName="item-info.json" />
    <EmbeddedResource Include="Assets\text-info.json" LogicalName="text-info.json" />
    <!-- Traducoes da interface (Services/Loc.cs); o portugues e o texto do proprio codigo -->
    <EmbeddedResource Include="Assets\lang\*.json" LogicalName="lang.%(Filename).json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fonte do tema Pixel (Pixelify Sans, SIL Open Font License 1.1: Assets/Fonts/OFL.txt) -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>
</Project>
