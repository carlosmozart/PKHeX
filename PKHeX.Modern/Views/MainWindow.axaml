<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PKHeX.Modern.ViewModels"
        x:Class="PKHeX.Modern.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PKHeX Modern"
        Width="1320" Height="820" MinWidth="980" MinHeight="600"
        Background="{DynamicResource AppBackground}"
        xmlns:views="using:PKHeX.Modern.Views">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
  </Window.KeyBindings>

  <!-- Toda a interface fica em MainView (reaproveitada no Android); a janela cuida de fechar, reiniciar e atualizar. -->
  <views:MainView x:Name="View" />
</Window>
