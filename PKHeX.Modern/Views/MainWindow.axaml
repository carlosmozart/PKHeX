<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PKHeX.Modern.ViewModels"
        x:Class="PKHeX.Modern.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PKHeX Modern"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        Background="{DynamicResource AppBackground}"
        DragDrop.AllowDrop="True">

  <Grid ColumnDefinitions="240,*,380" RowDefinitions="*,Auto">

    <!-- Barra lateral -->
    <Border Grid.RowSpan="2" Background="{DynamicResource SidebarBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0" Padding="16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4">
          <TextBlock Text="PKHeX" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
          <TextBlock Text="Modern" Classes="muted" Margin="0,0,0,16" />
          <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="Abrir save..." Click="OnOpen" />
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="Exportar save..." Click="OnExport" IsEnabled="{Binding HasSave}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="4">
          <Button Classes="ghost" Content="◐  Alternar tema" Command="{Binding ToggleThemeCommand}" />
        </StackPanel>
        <Border Classes="card" Margin="0,20,0,0" VerticalAlignment="Top" IsVisible="{Binding HasSave}">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding TrainerInfo}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ChecksumInfo}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <!-- Caixas -->
    <Grid Grid.Column="1" Margin="24" RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16" IsVisible="{Binding HasSave}">
        <Button Content="‹" FontSize="18" Command="{Binding PreviousBoxCommand}" />
        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
          <TextBlock Text="{Binding BoxName}" Classes="title" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" HorizontalAlignment="Center"
                     Text="{Binding BoxLabel}" />
        </StackPanel>
        <Button Grid.Column="2" Content="›" FontSize="18" Command="{Binding NextBoxCommand}" />
      </Grid>

      <Border Grid.Row="1" Classes="card" IsVisible="{Binding !HasSave}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
          <TextBlock Text="Arraste um arquivo de save aqui" Classes="title" HorizontalAlignment="Center" />
          <TextBlock Text="ou use o botão “Abrir save...”" Classes="muted" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Classes="card" IsVisible="{Binding HasSave}" VerticalAlignment="Top">
        <ItemsControl ItemsSource="{Binding Slots}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel MaxWidth="500" HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SlotViewModel">
              <Button Classes="slot" Classes.selected="{Binding IsSelected}"
                      ToolTip.Tip="{Binding Tooltip}"
                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectSlotCommand}"
                      CommandParameter="{Binding}">
                <Image Source="{Binding Sprite}" Width="68" Height="56" Stretch="Uniform"
                       RenderOptions.BitmapInterpolationMode="None" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </Grid>

    <!-- Editor -->
    <Border Grid.Column="2" Background="{DynamicResource SidebarBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,0,0">
      <Panel>
        <TextBlock Text="Selecione um Pokémon" Classes="muted" IsVisible="{Binding !HasEditor}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ScrollViewer IsVisible="{Binding HasEditor}">
          <ContentControl Content="{Binding Editor}" Margin="20" />
        </ScrollViewer>
      </Panel>
    </Border>

    <!-- Barra de status -->
    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Padding="16,6"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding Status}" Classes="muted" FontSize="12" />
    </Border>
  </Grid>
</Window>
