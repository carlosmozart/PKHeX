<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PKHeX.Modern.ViewModels"
             xmlns:c="using:PKHeX.Modern.Controls"
             xmlns:core="using:PKHeX.Core"
             x:Class="PKHeX.Modern.Views.PokemonEditorView"
             x:DataType="vm:PokemonEditorViewModel">
  <!-- Opcoes das listas (bola, local, habilidade, forma, Tera Type). Um modelo de item, e nao DisplayMemberBinding:
       com DisplayMemberBinding a caixa fechada reaproveita o texto da lista aberta e fica em branco quando a lista muda. -->
  <UserControl.Resources>
    <DataTemplate x:Key="ComboItemTemplate" DataType="core:ComboItem">
      <TextBlock Text="{Binding Text}" />
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:MemoryViewModel">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
          <TextBlock Text="Memória" Classes="muted" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" MaxDropDownHeight="360" ItemsSource="{Binding Memories}" SelectedItem="{Binding Memory}"
                    ItemTemplate="{StaticResource ComboItemTemplate}" />
          <TextBlock Grid.Row="1" Text="Detalhe" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding HasArgument}" />
          <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" MaxDropDownHeight="360" ItemsSource="{Binding Arguments}"
                    SelectedItem="{Binding Argument}" ItemTemplate="{StaticResource ComboItemTemplate}" IsVisible="{Binding HasArgument}" />
          <TextBlock Grid.Row="2" Text="Intensidade" Classes="muted" VerticalAlignment="Center" />
          <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Intensities}" SelectedIndex="{Binding Intensity}" />
          <TextBlock Grid.Row="3" Text="Sentimento" Classes="muted" VerticalAlignment="Center" />
          <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Feelings}" SelectedIndex="{Binding Feeling}" />
        </Grid>
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>
  <StackPanel Spacing="12">

    <!-- Cabecalho -->
    <Border Classes="card hero">
      <Grid ColumnDefinitions="Auto,*">
        <Border Classes="spriteWell" Width="112" Height="100">
          <Image Source="{Binding Sprite}" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding SpeciesName}" Classes="title" />
            <TextBlock Text="{Binding GenderSymbol}" FontSize="18" Classes="muted" VerticalAlignment="Center" />
            <Button x:Name="ShinyStar" Classes="shinyStar" Classes.on="{Binding IsShiny}" Content="{Binding ShinySymbol}"
                    IsEnabled="{Binding CanToggleShiny}" Click="OnShinyClick" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding ShinyShortcutsTip}" ToolTip.ShowOnDisabled="True" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Types}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TypeChip">
                <Border Classes="chip" Background="{Binding Brush}">
                  <TextBlock Text="{Binding Name}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Classes="chip" Background="{DynamicResource Good}" IsVisible="{Binding ShowLegal}">
              <TextBlock Text="✓ Legal" />
            </Border>
            <Border Classes="chip" Background="{DynamicResource Bad}" IsVisible="{Binding ShowIllegal}">
              <TextBlock Text="✕ Ilegal" />
            </Border>
            <Border Classes="chip" Background="{DynamicResource CardBorder}" IsVisible="{Binding LegalMode}"
                    ToolTip.Tip="Modo legal ligado: só opções legais; mudanças que deixariam o Pokémon ilegal são desfeitas">
              <TextBlock Text="🛡" />
            </Border>
            <TextBlock Text="{Binding Location}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
      <Button Content="⇩ Colar Showdown" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnImportShowdown" />
      <Button Grid.Column="1" Content="⇧ Copiar Showdown" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnExportShowdown" />
    </Grid>

    <TabControl Classes="editorTabs" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="Visão geral">
        <StackPanel Spacing="12" Margin="0,12,0,0">
          <!-- Geral -->
          <Border Classes="card">
            <StackPanel>
              <TextBlock Text="GERAL" Classes="section" Margin="0,0,0,8" />
              <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Text="Apelido" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Nickname}" />
                <TextBlock Grid.Row="1" Text="Espécie" VerticalAlignment="Center" />
                <AutoCompleteBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding SpeciesNames}"
                                 SelectedItem="{Binding SelectedSpeciesName}" FilterMode="ContainsOrdinal" MinimumPrefixLength="1"
                                 MaxDropDownHeight="320" Watermark="Digite para buscar a espécie"
                                 ToolTip.Tip="Digite parte do nome (ex.: chu) e escolha na lista" />
                <TextBlock Grid.Row="2" Text="Nível" VerticalAlignment="Center" />
                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <Slider Minimum="1" Maximum="100" Value="{Binding Level}" IsSnapToTickEnabled="True" TickFrequency="1" />
                  <NumericUpDown Grid.Column="1" Width="110" Minimum="1" Maximum="100" FormatString="0" Value="{Binding Level}" />
                </Grid>
                <TextBlock Grid.Row="3" Text="Natureza" VerticalAlignment="Center" />
                <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding NatureList}" SelectedIndex="{Binding Nature}" />
                <TextBlock Grid.Row="4" Text="Item" VerticalAlignment="Center" />
                <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                  <Image Source="{Binding HeldItemIcon}" Width="24" Height="24" IsVisible="{Binding HasItem}" VerticalAlignment="Center"
                         ToolTip.Tip="{Binding HeldItemTip}" />
                  <AutoCompleteBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding ItemOptions}" SelectedItem="{Binding SelectedItem}"
                                   ValueMemberBinding="{Binding Text, x:DataType=core:ComboItem}" FilterMode="ContainsOrdinal"
                                   MinimumPrefixLength="1" MaxDropDownHeight="320" Watermark="Nenhum (digite para buscar)">
                    <AutoCompleteBox.ItemTemplate>
                      <DataTemplate x:DataType="core:ComboItem">
                        <TextBlock Text="{Binding Text}" />
                      </DataTemplate>
                    </AutoCompleteBox.ItemTemplate>
                  </AutoCompleteBox>
                  <Button Grid.Column="2" Classes="ghost small" Content="✕" Command="{Binding ClearItemCommand}"
                          IsVisible="{Binding HasItem}" ToolTip.Tip="Remover item" />
                </Grid>
                <TextBlock Grid.Row="5" Text="Habilidade" VerticalAlignment="Center" />
                <ComboBox Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding AbilityOptions}"
                          SelectedItem="{Binding SelectedAbility}" ItemTemplate="{StaticResource ComboItemTemplate}"
                          ToolTip.Tip="{Binding AbilityTip}" />
                <TextBlock Grid.Row="6" Text="Forma" VerticalAlignment="Center" IsVisible="{Binding HasForms}" />
                <ComboBox Grid.Row="6" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding FormOptions}" IsVisible="{Binding HasForms}"
                          SelectedItem="{Binding SelectedForm}" ItemTemplate="{StaticResource ComboItemTemplate}"
                          ToolTip.Tip="Formas que existem neste jogo. No modo legal, trocar a forma gera o Pokémon de novo a partir de um encontro dela." />
                <TextBlock Grid.Row="7" Text="Tera Type" VerticalAlignment="Center" IsVisible="{Binding HasTera}" />
                <ComboBox Grid.Row="7" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding TeraOptions}" IsVisible="{Binding HasTera}"
                          SelectedItem="{Binding SelectedTera}" ItemTemplate="{StaticResource ComboItemTemplate}"
                          ToolTip.Tip="Como as Tera Shards: muda o Tera Type (voltar ao original desfaz a troca)" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Evoluir por item: so aparece para especies que evoluem com pedras e afins -->
          <Border Classes="card" IsVisible="{Binding HasItemEvolutions}">
            <StackPanel Spacing="8">
              <TextBlock Text="EVOLUÇÃO POR ITEM" Classes="section" Margin="0" />
              <ItemsControl ItemsSource="{Binding ItemEvolutions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ItemEvolutionOption">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <Button Classes="small info" Content="{Binding Label, StringFormat='💎  {0}'}" Command="{Binding Command}"
                              IsEnabled="{Binding !IsBlocked}" ToolTip.Tip="{Binding Tooltip}" ToolTip.ShowOnDisabled="True" />
                      <TextBlock Grid.Column="1" Text="{Binding Requirement}" Classes="muted" FontSize="12"
                                 VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Evoluir por troca: so aparece para especies que evoluem assim -->
          <Border Classes="card" IsVisible="{Binding HasTradeEvolutions}">
            <StackPanel Spacing="8">
              <TextBlock Text="EVOLUÇÃO POR TROCA" Classes="section" Margin="0" />
              <ItemsControl ItemsSource="{Binding TradeEvolutions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TradeEvolutionOption">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <Button Classes="small info" Content="{Binding Label, StringFormat='🔄  {0}'}" Command="{Binding Command}"
                              IsEnabled="{Binding !IsBlocked}" ToolTip.Tip="{Binding Tooltip}" ToolTip.ShowOnDisabled="True" />
                      <TextBlock Grid.Column="1" Text="{Binding Requirement}" Classes="muted" FontSize="12"
                                 VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding ShowLegality}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="LEGALIDADE" Classes="section" Margin="0" />
                <Border Grid.Column="1" Classes="chip" Background="{DynamicResource Good}" IsVisible="{Binding ShowLegal}"><TextBlock Text="✓ Legal" /></Border>
                <Border Grid.Column="1" Classes="chip" Background="{DynamicResource Bad}" IsVisible="{Binding ShowIllegal}"><TextBlock Text="✕ Ilegal" /></Border>
              </Grid>
              <ItemsControl ItemsSource="{Binding LegalityIssues}" IsVisible="{Binding HasLegalityIssues}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" FontSize="12" Margin="0,1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="✨  Legalizar"
            Command="{Binding LegalizeCommand}" IsVisible="{Binding ShowLegalize}"
            ToolTip.Tip="Gera de novo a partir de um encontro real deste jogo (PID/IV corretos), mantendo natureza, nível, item, apelido e golpes quando possível" />
    <TextBlock Text="Correções sugeridas" Classes="muted" FontSize="11" Margin="0,4,0,0" />
              <WrapPanel ItemSpacing="6" LineSpacing="6">
                <Button Classes="small" Content="Golpes sugeridos" Command="{Binding SuggestMovesCommand}"
                        ToolTip.Tip="Troca os golpes por um conjunto legal (aprendidos por nível)" />
                <Button Classes="small" Content="Golpes de reaprender" Command="{Binding SuggestRelearnCommand}" IsVisible="{Binding HasRelearnMoves}"
                        ToolTip.Tip="Preenche os golpes de reaprender a partir do encontro" />
                <Button Classes="small" Content="Encontro sugerido" Command="{Binding SuggestMetCommand}"
                        ToolTip.Tip="Ajusta local e nível de encontro (e o nível atual, se estiver abaixo do mínimo)" />
                <Button Classes="small" Content="IVs máximos" Command="{Binding FixIVsCommand}" />
              </WrapPanel>
              <Expander Header="Relatório completo" HorizontalAlignment="Stretch">
                <SelectableTextBlock Text="{Binding LegalityReport}" TextWrapping="Wrap" FontSize="12" />
              </Expander>
            </StackPanel>
          </Border>

        </StackPanel>
      </TabItem>
      <TabItem Header="Atributos">
        <StackPanel Spacing="12" Margin="0,12,0,0">
          <!-- Atributos -->
          <Border Classes="card">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="ATRIBUTOS" Classes="section" Margin="0" />
                <TextBlock Grid.Column="1" Text="{Binding StatTotal, StringFormat='Total {0}'}" Classes="muted" FontSize="12" />
              </Grid>
              <c:StatRadar Height="190" Values="{Binding RadarValues}" Labels="{Binding StatLabels}"
                           Fill="{DynamicResource Accent}" GridBrush="{DynamicResource CardBorder}" LabelBrush="{DynamicResource TextMuted}" />

              <ItemsControl ItemsSource="{Binding Stats}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StatViewModel">
                    <Grid ColumnDefinitions="52,*,44" RowDefinitions="Auto,Auto,Auto" Margin="0,4">
                      <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{Binding Color}" />
                        <TextBlock Text="{Binding NatureArrow}" FontSize="9" VerticalAlignment="Center"
                                   Classes.up="{Binding IsBoosted}" Classes.down="{Binding IsHindered}" />
                      </StackPanel>
                      <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                        <ProgressBar Classes="base" Minimum="0" Maximum="1" Value="{Binding BaseRatio}" Foreground="{Binding Color}" />
                        <TextBlock Grid.Column="1" Text="{Binding Base, StringFormat='base {0}'}" Classes="muted" FontSize="11" />
                      </Grid>
                      <TextBlock Grid.Column="2" Text="{Binding Total}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right" />

                      <TextBlock Grid.Row="1" Text="IV" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0" />
                      <Slider Grid.Row="1" Grid.Column="1" Classes="stat" Minimum="0" Maximum="{Binding MaxIV}" Value="{Binding IV}"
                              IsSnapToTickEnabled="True" TickFrequency="1" Foreground="{Binding Color}" />
                      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding IV}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                      <TextBlock Grid.Row="2" Text="EV" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0" />
                      <Slider Grid.Row="2" Grid.Column="1" Classes="stat" Minimum="0" Maximum="{Binding MaxEV}" Value="{Binding EV}"
                              IsSnapToTickEnabled="True" TickFrequency="4" Foreground="{Binding Color}" />
                      <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding EV}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,4,0,0">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding IVSummary}" Classes="muted" FontSize="11" />
                  <TextBlock Text="{Binding EVSummary}" Classes="muted" FontSize="11" />
                </StackPanel>
                <Button Grid.Column="1" Classes="small" Content="IVs máximos" Command="{Binding MaxIVsCommand}" />
                <Button Grid.Column="2" Classes="small" Content="Zerar EVs" Command="{Binding ClearEVsCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Hyper Training (Gen 7+) -->
          <Border Classes="card" IsVisible="{Binding HasHyperTraining}">
            <StackPanel Spacing="6">
              <TextBlock Text="HYPER TRAINING" Classes="section" Margin="0" />
              <TextBlock Text="Conta como IV 31 no atributo. Exige nível 100 (50 em Scarlet/Violet)." Classes="muted" FontSize="11" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding HyperTraining}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HyperTrainViewModel">
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" FontSize="12" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

        </StackPanel>
      </TabItem>
      <TabItem Header="Golpes">
        <StackPanel Spacing="12" Margin="0,12,0,0">
          <!-- Golpes -->
          <Border Classes="card">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                <TextBlock Text="GOLPES" Classes="section" Margin="0" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="small" Content="PP cheio" Command="{Binding HealPPCommand}"
                        ToolTip.Tip="Restaura o PP de todos os golpes" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Moves}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MoveSlotViewModel">
                    <Border Classes="moveRow">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                          <AutoCompleteBox HorizontalAlignment="Stretch" SelectedItem="{Binding MoveName}"
                                           ItemsSource="{Binding $parent[UserControl].((vm:PokemonEditorViewModel)DataContext).MoveOptions}"
                                           ValueMemberBinding="{Binding Name, x:DataType=vm:MoveOption}"
                                           FilterMode="ContainsOrdinal" MinimumPrefixLength="0" MaxDropDownHeight="360"
                                           Watermark="Digite para buscar o golpe"
                                           ToolTip.Tip="{Binding FullTip}">
                            <AutoCompleteBox.ItemTemplate>
                              <DataTemplate x:DataType="vm:MoveOption">
                                <Border Classes="moveOption" Classes.learnable="{Binding IsLearnable}" ToolTip.Tip="{Binding Tip}" ToolTip.Placement="Right">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Text="✓" FontWeight="Bold" IsVisible="{Binding IsLearnable}" />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </AutoCompleteBox.ItemTemplate>
                          </AutoCompleteBox>
                          <Button Grid.Column="1" Classes="ghost small" Content="✕" Command="{Binding ClearCommand}"
                                  IsVisible="{Binding HasMove}" ToolTip.Tip="Remover golpe" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding HasMove}">
                          <Border Classes="chip" Background="{Binding TypeBrush}" MinWidth="64" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TypeName}" HorizontalAlignment="Center" />
                          </Border>
                          <ProgressBar Grid.Column="1" Classes="pp" Minimum="0" Maximum="1" Value="{Binding PPRatio}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding PPText}" FontSize="12" VerticalAlignment="Center" MinWidth="58" />
                          <ComboBox Grid.Column="3" ItemsSource="{Binding PPUpOptions}" SelectedIndex="{Binding PPUps}" MinWidth="64"
                                    IsVisible="{Binding $parent[UserControl].((vm:PokemonEditorViewModel)DataContext).HasPPUps}"
                                    ToolTip.Tip="PP Ups" />
                        </Grid>
                        <TextBlock Text="{Binding Tip}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                                   IsVisible="{Binding Tip, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

        </StackPanel>
      </TabItem>
      <TabItem Header="Encontro">
        <StackPanel Spacing="12" Margin="0,12,0,0">
          <!-- Encontro -->
          <Border Classes="card">
            <StackPanel>
              <TextBlock Text="ENCONTRO" Classes="section" Margin="0,0,0,8" />
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Text="Jogo de origem" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding OriginGame}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Row="5" Text="Encontro" VerticalAlignment="Center" IsVisible="{Binding LegalMode}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CurrentEncounter}" TextWrapping="Wrap" VerticalAlignment="Center" IsVisible="{Binding LegalMode}" />
                <TextBlock Grid.Row="6" Text="Trocar encontro" VerticalAlignment="Center" IsVisible="{Binding LegalMode}" />
                <ComboBox Grid.Row="6" Grid.Column="1" HorizontalAlignment="Stretch" IsVisible="{Binding LegalMode}" MaxDropDownHeight="360"
                          ItemsSource="{Binding EncounterOptions}" SelectedItem="{Binding SelectedEncounter}" PlaceholderText="Escolha outro encontro deste jogo"
                          ToolTip.Tip="Modo legal: em vez de mudar local e nível à mão, escolha um encontro real; o Pokémon é gerado de novo a partir dele, mantendo natureza, nível, item, apelido e golpes quando possível." />
                <TextBlock Grid.Row="1" Text="Bola" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding BallList}"
                          SelectedItem="{Binding Ball}" ItemTemplate="{StaticResource ComboItemTemplate}" />
                <TextBlock Grid.Row="2" Text="Local" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding MetLocationList}"
                          SelectedItem="{Binding MetLocation}" ItemTemplate="{StaticResource ComboItemTemplate}"
                          IsEnabled="{Binding !LegalMode}" ToolTip.ShowOnDisabled="True"
                          ToolTip.Tip="No modo legal, local e nível vêm do encontro: use “Trocar encontro” abaixo" />
                <TextBlock Grid.Row="3" Text="Nível" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="3" Grid.Column="1" Width="110" HorizontalAlignment="Left" Minimum="0" Maximum="100" FormatString="0" Value="{Binding MetLevel}"
                               IsEnabled="{Binding !LegalMode}" />
                <TextBlock Grid.Row="4" Text="Data" VerticalAlignment="Center" IsVisible="{Binding HasMetDate}" />
                <CalendarDatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding MetDate}" IsVisible="{Binding HasMetDate}" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
      <TabItem Header="Treinador">
        <StackPanel Spacing="12" Margin="0,12,0,0">
          <!-- Treinador original -->
          <Border Classes="card">
            <StackPanel>
              <TextBlock Text="TREINADOR ORIGINAL" Classes="section" Margin="0,0,0,8" />
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Text="Nome (OT)" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding TrainerName}" />
                <TextBlock Grid.Row="1" Text="TID" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Width="140" HorizontalAlignment="Left" Minimum="0" Maximum="65535" FormatString="00000" Value="{Binding TID}" />
                <TextBlock Grid.Row="2" Text="SID" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Width="140" HorizontalAlignment="Left" Minimum="0" Maximum="65535" FormatString="00000" Value="{Binding SID}" />
                <TextBlock Grid.Row="3" Text="Gênero" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Row="3" Grid.Column="1" IsChecked="{Binding TrainerIsFemale}" OnContent="Feminino" OffContent="Masculino" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
      <TabItem Header="Extras">
        <StackPanel Spacing="12" Margin="0,12,0,0">
          <!-- Extras -->
          <Border Classes="card">
            <StackPanel>
              <TextBlock Text="EXTRAS" Classes="section" Margin="0,0,0,8" />
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Text="Felicidade" VerticalAlignment="Center" IsVisible="{Binding HasFriendship}" />
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasFriendship}">
                  <Slider Minimum="0" Maximum="255" Value="{Binding Friendship}" IsSnapToTickEnabled="True" TickFrequency="1" />
                  <NumericUpDown Grid.Column="1" Width="110" Minimum="0" Maximum="255" FormatString="0" Value="{Binding Friendship}" />
                </Grid>
                <TextBlock Grid.Row="1" Text="PID" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Width="140" HorizontalAlignment="Left" MaxLength="8" FontFamily="Consolas,monospace"
                         Text="{Binding PIDText, UpdateSourceTrigger=LostFocus}"
                         ToolTip.Tip="Hexadecimal; vale ao sair do campo. No modo legal, um PID que deixe o Pokémon ilegal é desfeito." />
                <TextBlock Grid.Row="2" Text="EC" VerticalAlignment="Center" IsVisible="{Binding HasEC}" />
                <TextBox Grid.Row="2" Grid.Column="1" Width="140" HorizontalAlignment="Left" MaxLength="8" FontFamily="Consolas,monospace"
                         Text="{Binding ECText, UpdateSourceTrigger=LostFocus}" IsVisible="{Binding HasEC}"
                         ToolTip.Tip="Encryption Constant (Gen 6+), hexadecimal" />
                <TextBlock Grid.Row="3" Text="Marcações" VerticalAlignment="Center" IsVisible="{Binding HasMarkings}" />
                <ItemsControl Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Markings}" IsVisible="{Binding HasMarkings}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MarkingViewModel">
                      <Button Classes="marking" Classes.on="{Binding IsOn}" Classes.pink="{Binding IsPink}" Content="{Binding Symbol}"
                              Command="{Binding ToggleCommand}" ToolTip.Tip="Clique para marcar (Gen 7+: azul → rosa → nenhuma)" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="ShinyButton" Grid.Row="4" Grid.Column="1" Classes="small" Content="{Binding ShinyActionText}"
                        IsEnabled="{Binding CanToggleShiny}" Click="OnShinyClick"
                        ToolTip.Tip="{Binding ShinyShortcutsTip}" ToolTip.ShowOnDisabled="True" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Dynamax/Gigantamax, alpha e nobre -->
          <Border Classes="card" IsVisible="{Binding HasSpecialFlags}">
            <StackPanel Spacing="8">
              <TextBlock Text="ESPECIAIS" Classes="section" Margin="0" />
              <Grid ColumnDefinitions="120,*" IsVisible="{Binding HasDynamax}">
                <TextBlock Text="Dynamax Level" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Width="110" HorizontalAlignment="Left" Minimum="0" Maximum="10" FormatString="0" Value="{Binding DynamaxLevel}" />
              </Grid>
              <CheckBox Content="Pode Gigantamax" IsChecked="{Binding CanGigantamax}" IsVisible="{Binding HasGigantamax}" />
              <CheckBox Content="Alpha" IsChecked="{Binding IsAlpha}" IsVisible="{Binding HasAlpha}" />
              <CheckBox Content="Nobre" IsChecked="{Binding IsNoble}" IsVisible="{Binding HasNoble}" />
            </StackPanel>
          </Border>

          <!-- Contest stats -->
          <Border Classes="card" IsVisible="{Binding HasContestStats}">
            <StackPanel Spacing="6">
              <TextBlock Text="CONTEST STATS" Classes="section" Margin="0" />
              <TextBlock Text="{Binding ContestNote}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding ContestStats}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ContestStatViewModel">
                    <StackPanel Margin="0,0,8,6" Spacing="2">
                      <TextBlock Text="{Binding Label}" Classes="muted" FontSize="11" />
                      <NumericUpDown Minimum="0" Maximum="255" FormatString="0" Value="{Binding Value}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
      <TabItem Header="Fitas e memórias">
        <StackPanel Spacing="12" Margin="0,12,0,0">
          <!-- Fitas -->
          <Border Classes="card" IsVisible="{Binding HasRibbons}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="FITAS" Classes="section" Margin="0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding RibbonSummary}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
              </Grid>
              <WrapPanel ItemSpacing="6" LineSpacing="6">
                <Button Classes="small" Content="✓ Todas as legais" Command="{Binding AddAllRibbonsCommand}"
                        ToolTip.Tip="Adiciona todas as fitas que este Pokémon pode ter pela história dele" />
                <Button Classes="small" Content="✕ Remover todas" Command="{Binding RemoveAllRibbonsCommand}" />
                <CheckBox Content="Só as que tem" IsChecked="{Binding OnlyOwnedRibbons}" FontSize="12" />
              </WrapPanel>
              <TextBox Text="{Binding RibbonFilter}" Watermark="Procurar fita..." />
              <ScrollViewer MaxHeight="420">
                <ItemsControl ItemsSource="{Binding Ribbons}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RibbonViewModel">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsOn}" IsVisible="{Binding IsFlag}" FontSize="12" />
                        <TextBlock Text="{Binding Name}" IsVisible="{Binding IsCount}" FontSize="12" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" Width="110" Minimum="0" Maximum="{Binding Max}" FormatString="0" Value="{Binding Count}"
                                       IsVisible="{Binding IsCount}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
          <TextBlock Text="Este formato não tem fitas." Classes="muted" IsVisible="{Binding !HasRibbons}" />

          <!-- Memorias (Gen 6+) -->
          <Border Classes="card" IsVisible="{Binding HasMemories}">
            <StackPanel Spacing="10">
              <TextBlock Text="MEMÓRIAS" Classes="section" Margin="0" />
              <ContentControl Content="{Binding OTMemory}" />
              <ContentControl Content="{Binding HTMemory}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
    </TabControl>

    <Border Classes="legalBlock" IsVisible="{Binding ShowLegalModeBlock}">
      <TextBlock TextWrapping="Wrap" FontSize="12"
                 Text="🛡 Modo legal: este Pokémon está ilegal e não pode ser aplicado. Use ✨ Legalizar ou as correções sugeridas na aba Visão geral." />
    </Border>
    <Button Classes="accent" Content="Aplicar alterações" HorizontalAlignment="Stretch" Height="40"
            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding ApplyCommand}"
            ToolTip.Tip="{Binding ApplyTip}" ToolTip.ShowOnDisabled="True" />
  </StackPanel>
</UserControl>
