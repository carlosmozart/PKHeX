<?xml version="1.0" encoding="utf-8"?>
<!--
  Publicacao do PKHeX.Modern: um unico PKHeX.Modern para osx-arm64 que nao exige o .NET instalado.
  Uso: dotnet publish PKHeX.Modern -p:PublishProfile=osx-arm64
  Saida: PKHeX.Modern/bin/publish/osx-arm64/PKHeX.Modern
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Bibliotecas nativas (Skia, HarfBuzz, ANGLE) vao dentro do exe e sao extraidas na primeira execucao. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- sem .pdb dos projetos referenciados (Core, Drawing) na pasta publicada -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>bin\publish\osx-arm64\</PublishDir>
  </PropertyGroup>
</Project>
