<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationId>io.github.carlosmozart.pkhexmodern.poc</ApplicationId>
    <ApplicationTitle>PKHeX Modern — Android PoC</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <!-- Override isolado: Avalonia 11 suporta SkiaSharp 3; as nativas precisam de alinhamento de 16 KB. -->
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Android" Version="3.119.0" />
    <ProjectReference Include="../../PKHeX.Core/PKHeX.Core.csproj" />
  </ItemGroup>
</Project>
